# Secret used to encrypt the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Google OAuth client credentials (Google Cloud Console > Google Auth Platform > Clients).
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Optional. Google Workspace domain allowed to sign in. Defaults to st.kic.ac.jp.
# Leave commented out to keep the default: an empty value overrides it and blocks every sign-in.
# NUXT_AUTH_ALLOWED_DOMAIN=
